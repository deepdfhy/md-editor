{
  "name": "md-editor",
  "version": "0.1.11",
  "private": true,
  "description": "基于 Electron + Vue3 的 Markdown 编辑器，4 列布局，面向代码笔记",
  "main": "electron/main.js",
  "author": "俊哥 / 虾技派",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_NAME/md-editor.git"
  },
  "homepage": "https://github.com/YOUR_NAME/md-editor#readme",
  "bugs": {
    "url": "https://github.com/YOUR_NAME/md-editor/issues"
  },
  "scripts": {
    "dev": "vite",
    "electron:dev": "cross-env DEV=1 electron .",
    "dev:all": "concurrently -k -n vite,electron \"npm:dev\" \"npm:electron:dev\"",
    "build": "vite build",
    "clean": "node scripts/clean.js",
    "pack": "npm run clean && npm run build && electron-builder --win portable",
    "dist": "npm run clean && npm run build && electron-builder --win nsis",
    "set-repo": "node scripts/set-repo.cjs"
  },
  "dependencies": {
    "@toast-ui/editor": "^3.2.2",
    "@toast-ui/editor-plugin-code-syntax-highlight": "^3.1.0",
    "highlight.js": "^11.10.0",
    "markdown-it": "^14.1.0",
    "minisearch": "^7.1.0",
    "prismjs": "^1.30.0",
    "vue": "^3.4.38"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.3",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^31.4.0",
    "electron-builder": "^24.13.3",
    "vite": "^5.4.3"
  },
  "build": {
    "appId": "com.md.editor",
    "productName": "MD 编辑器",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
